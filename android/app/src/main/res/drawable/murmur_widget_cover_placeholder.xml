<?xml version="1.0" encoding="utf-8"?>
<!-- Cover while nothing is loaded or the art is still on its way: the MURMUR mark on a violet tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="96dp" android:height="96dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient android:angle="315" android:startColor="#FF3B3066" android:endColor="#FF14111F" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
    <item android:width="46dp" android:height="46dp" android:gravity="center" android:drawable="@drawable/murmur_mark" />
</layer-list>
